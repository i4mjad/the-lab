{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "catalog", "dependencies"],
  "properties": {
    "$schema": { "type": "string" },
    "schemaVersion": { "const": 1 },
    "catalog": { "type": "string" },
    "dependencies": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "groups", "status", "hosts", "license", "source", "resolved", "trust", "invocation", "installer"],
        "properties": {
          "id": { "type": "string" },
          "groups": { "type": "array", "minItems": 1, "items": { "type": "string" }, "uniqueItems": true },
          "status": { "enum": ["required", "conditional", "optional"] },
          "hosts": { "type": "array", "minItems": 1, "items": { "enum": ["claude", "codex"] }, "uniqueItems": true },
          "license": { "type": "string", "minLength": 2 },
          "source": { "type": "object", "required": ["kind", "url"] },
          "resolved": { "type": "object", "required": ["kind", "value"] },
          "trust": { "type": "object", "required": ["level", "review"] },
          "invocation": { "type": "object", "required": ["policy", "roles", "entrypoints"] },
          "installer": { "type": "object", "required": ["kind"] }
        }
      }
    }
  }
}
